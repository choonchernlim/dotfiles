# herdr writes runtime state beside its config (logs, sockets, session
# snapshots, release-notes cache, plugin lock); only config.toml is authored
home/.config/herdr/*
!home/.config/herdr/config.toml

# macOS + nix build noise
.DS_Store
result
result-*

# no-mistakes local validation state - never commit in this public repo
.no-mistakes/

# Jetbrain IDE
.idea/
*.iml

# git-hooks.nix generates this on `nix develop`; it is a derived artifact, not hand-authored
.pre-commit-config.yaml

# nix-direnv per-repo devShell cache + GC root (machine-local; pins the pre-commit closure)
.direnv/
