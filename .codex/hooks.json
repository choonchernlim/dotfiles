{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "r=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0; exec \"$r/scripts/format-hook.sh\""
          }
        ]
      }
    ]
  }
}
