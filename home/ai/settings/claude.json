{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm *)",
      "Bash(pip3 *)",
      "Bash(pytest *)",
      "Bash(python3 *)",
      "Bash(uv *)",
      "Bash(lsof *)",
      "Bash(source *)",
      "Bash(* --help)",
      "mcp__playwright__*",
      "mcp__ide__getDiagnostics"
    ],
    "deny": [
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(curl *)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)"
    ]
  },
  "model": "opusplan[1m]",
  "statusLine": {
    "type": "command",
    "command": "bash ~/.dotfiles/home/ai/statusline.sh"
  },
  "enabledPlugins": {
    "langfuse-observability@langfuse-observability": true
  },
  "extraKnownMarketplaces": {
    "langfuse-observability": {
      "source": {
        "source": "git",
        "url": "https://github.com/langfuse/Claude-Observability-Plugin.git"
      }
    }
  },
  "effortLevel": "high",
  "theme": "dark-ansi",
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true
}
