{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "read": {
      "*": "allow",
      "~/.ssh/**": "deny",
      "~/.gnupg/**": "deny",
      "*.env": "deny",
      "*.env.local": "deny",
      "*.env.*.local": "deny",
      "*.env.production": "deny",
      "*.env.*": "ask",
      "*.env.example": "allow"
    },
    "bash": {
      "*": "ask",
      "npm test *": "allow",
      "npm run test *": "allow",
      "npm run lint *": "allow",
      "npm run build *": "allow",
      "npm ls *": "allow",
      "pytest *": "allow",
      "uv run pytest *": "allow",
      "pip3 list *": "allow",
      "pip3 show *": "allow",
      "lsof *": "allow"
    }
  }
}
