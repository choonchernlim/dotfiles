{
  "$schema": "https://opencode.ai/tui.json",
  // From `herdr integration install opencode`: the herdr TUI session plugin.
  "plugin": ["./herdr-tui-session.js"],
  // Claude's inputNeededNotifEnabled: desktop notifications while unfocused.
  "attention": { "enabled": true, "notifications": true, "sound": false }
}
